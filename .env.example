# Sehat Sathi (Qwen-only build) — copy to .env and fill in. Never commit .env.
# All AI in this project is Qwen, served by Alibaba DashScope.
# Model IDs below are the Qwen models published on ModelScope.

# Postgres connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/sehat_sathi"

# DashScope API key (Alibaba Cloud Model Studio). Required for live AI calls.
# Without it, /api/extract answers 503 — the app never fakes AI results.
DASHSCOPE_API_KEY=""

# DashScope compatible-mode base URL.
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Qwen vision model for document extraction (Prompt A).
QWEN_VL_MODEL="qwen-vl-max"

# Qwen chat model for reasoning / translation (Prompt B).
QWEN_MODEL="qwen-max"
