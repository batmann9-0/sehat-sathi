# Sehat Sathi (Qwen-only build) — copy to .env and fill in. Never commit .env.
# All AI in this project is Qwen, hosted on ModelScope and served through
# ModelScope's API-Inference endpoint. No other AI provider is used.

# Postgres connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/sehat_sathi"

# ModelScope access token. Required for live AI calls.
# Create it in your ModelScope account: modelscope.cn → avatar →
# Account Settings → Access Tokens → create token.
# Without it, /api/extract answers 503 — the app never fakes AI results.
MODELSCOPE_API_TOKEN=""

# ModelScope API-Inference base URL (OpenAI-compatible chat completions).
QWEN_BASE_URL="https://api-inference.modelscope.cn/v1"

# Qwen vision model for document extraction (Prompt A) — ModelScope-hosted
# model ID. Swap for Qwen/Qwen2.5-VL-7B-Instruct for a lighter variant.
QWEN_VL_MODEL="Qwen/Qwen2.5-VL-72B-Instruct"

# Qwen chat model for reasoning / translation (Prompt B) — ModelScope-hosted
# model ID. Swap for Qwen/Qwen2.5-7B-Instruct for a lighter variant.
QWEN_MODEL="Qwen/Qwen2.5-72B-Instruct"
